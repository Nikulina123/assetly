{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/app/templates/**,backend/app/static/**,AssetlyAgent_macOS.sh,AssetlyAgent_Linux.sh}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
